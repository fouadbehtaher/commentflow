      "parameters": {
        "jsCode": "const q = $input.first().json.query || {};\nconst good = q['hub.mode'] === 'subscribe' && $env.WEBHOOK_VERIFY_TOKEN && q['hub.verify_token'] === $env.WEBHOOK_VERIFY_TOKEN;\nreturn [{ json: { ok: !!good, challenge: good ? String(q['hub.challenge'] || '') : 'forbidden' } }];\n"
      },
