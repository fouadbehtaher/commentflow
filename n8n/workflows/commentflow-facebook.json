    {
      "parameters": {
        "jsCode": "// Flatten Facebook Page \"feed\" webhook into new-comment events.\nconst body = $input.first().json.body || {};\nconst page = $env.FB_PAGE_ID || '';\nconst out = [];\nfor (const entry of body.entry || []) {\n  for (const ch of entry.changes || []) {\n    const v = ch.value || {};\n    if (ch.field !== 'feed' || v.item !== 'comment' || v.verb !== 'add') continue;\n    const from = v.from || {};\n    if (!v.comment_id || from.id === page) continue;\n    out.push({ json: { kind: 'comment', comment_id: v.comment_id, text: v.message || '', igsid: from.id || '', username: from.name || '', media_id: v.post_id || '' } });\n  }\n}\nreturn out;\n"
      },
      "id": "270a35fc-a05d-54c3-a23f-b1337fa5d191",
      "name": "Split events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NOTION_BASE }}/databases/{{ $env.NOTION_DATABASE_ID }}/query",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.NOTION_TOKEN }}"
            },
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
